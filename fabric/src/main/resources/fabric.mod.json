{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "license": "${mod_license}",
  "icon": "assets/mobfarmingsupplies/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.bobofraggins.mobfarmingsupplies.fabric.MobFarmingSuppliesFabric"
    ],
    "client": [
      "net.bobofraggins.mobfarmingsupplies.fabric.MobFarmingSuppliesFabricClient"
    ],
    "jei_mod_plugin": [
      "net.bobofraggins.mobfarmingsupplies.jei.MobFarmingSuppliesJeiPlugin"
    ],
    "jade": [
      "net.bobofraggins.mobfarmingsupplies.tank.TankJadePlugin",
      "net.bobofraggins.mobfarmingsupplies.glamping.present.PresentJadePlugin",
      "net.bobofraggins.mobfarmingsupplies.bridge.PickedNameJadePlugin"
    ]
  },
  "mixins": [
    "mobfarmingsupplies.mixins.json",
    "mobfarmingsupplies-common.mixins.json",
    "mobfarmingsupplies-magichat.mixins.json",
    "mobfarmingsupplies-present.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version_min}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "architectury": ">=${architectury_version_min}"
  },
  "suggests": {
    "modonomicon": "*",
    "jade": "*",
    "jei": "*",
    "aquaculture": "*",
    "aether_ii": "*",
    "evilcraft": "*",
    "trinkets": "*"
  }
}
