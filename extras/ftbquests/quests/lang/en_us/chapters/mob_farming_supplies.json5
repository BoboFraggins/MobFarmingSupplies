{
  "chapter.3CE8D6EA98959768.title": "Mob Farming Supplies",
  "chapter.3CE8D6EA98959768.chapter_subtitle": [
    "The mod's advancements, as quests",
  ],
  "quest.4E11D6BBB7E7C998.title": "Mob Farming Supplies",
  "quest.4E11D6BBB7E7C998.quest_subtitle": "Everything a responsible mob farmer needs. And a few things they don't.",
  "quest.4E11D6BBB7E7C998.quest_desc": [
    "Welcome to &6Mob Farming Supplies&r!",
    "",
    "This chapter follows the mod's three advancement lines: &bLogistics&r, &aMob Farming&r and &dFun Stuff&r. Every quest completes when you earn the matching advancement.",
    "",
    "Pick up any item from the mod to begin.",
  ],
  "quest.6A8DF2999CD70183.title": "Crushing It",
  "quest.6A8DF2999CD70183.quest_subtitle": "Drop an anvil on quartz. For science.",
  "quest.6A8DF2999CD70183.quest_desc": [
    "Drop an &eanvil&r onto &eNether Quartz&r lying on the ground to crush it into a &eSilicon Clump&r.",
    "",
    "Smelt the clump into &eSilicon&r, then use a stonecutter to slice it into &eSilicon Wafers&r: you'll need them for filters.",
  ],
  "quest.478AB4382BBF7378.title": "Read the Fine Print",
  "quest.478AB4382BBF7378.quest_subtitle": "Scribe an Item Filter at the Filter Scribing Terminal.",
  "quest.478AB4382BBF7378.quest_desc": [
    "Craft a &eBlank Filter&r and a &eFilter Scribing Terminal&r.",
    "",
    "Put the Blank Filter in the terminal, choose what it should match, and scribe it into an &eItem Filter&r.",
  ],
  "quest.63FB1D2B18954C06.title": "A Place for Everything",
  "quest.63FB1D2B18954C06.quest_subtitle": "...and everything in its place. Sort items with a Logistic Sorter.",
  "quest.63FB1D2B18954C06.quest_desc": [
    "Place a &eLogistic Sorter&r and put an &eItem Filter&r into one of its filter slots.",
    "",
    "Each side can be set to &9Input&r, &aMatch&r or &cNo Match&r: matching items go one way, everything else the other.",
  ],
  "quest.5CBB7D677384D6FC.title": "Which Way Is Up?",
  "quest.5CBB7D677384D6FC.quest_subtitle": "Hoppers have always been a little narrow-minded. Build an Omnidirectional Hopper.",
  "quest.5CBB7D677384D6FC.quest_desc": [
    "Four hoppers around a block of redstone make an &eOmnidirectional Hopper&r.",
    "",
    "Every side can pull or push, and it moves fluids (and energy, on NeoForge) as well as items. Install Item Filters to choose which items it moves.",
  ],
  "quest.4C799A84D50EA814.title": "Spooky Action at a Distance",
  "quest.4C799A84D50EA814.quest_subtitle": "Send items through an Einstein-Rosen Bridge into another dimension. Einstein would hate this.",
  "quest.4C799A84D50EA814.quest_desc": [
    "Craft a linked pair of &eEinstein-Rosen Bridges&r: obsidian, two Omnidirectional Hoppers and an ender pearl. Bridges on the same channel are connected, wherever they are.",
    "",
    "Put one in the Nether, one in the Overworld, and send something through. Stay within 16 blocks of either end to get credit.",
  ],
  "quest.2A7E7D1AD1F43950.title": "Some Assembly Required",
  "quest.2A7E7D1AD1F43950.quest_subtitle": "Build a Mob Harvester. The mobs were not consulted.",
  "quest.2A7E7D1AD1F43950.quest_desc": [
    "Build and place a &eMob Harvester&r. It attacks the mobs within its reach, so you don't have to.",
    "",
    "Sharpness, Looting and Beheading Upgrades make it hit harder and drop more.",
  ],
  "quest.1DF963DF9573D939.title": "Waste Not, Want Not",
  "quest.1DF963DF9573D939.quest_subtitle": "Bank some experience in an Experience Syringe, then take it back out.",
  "quest.1DF963DF9573D939.quest_desc": [
    "An &eExperience Syringe&r stores your XP for later.",
    "",
    "&6Shift + right-click&r to store your progress toward the next level. &6Right-click&r to take back enough to level up. Do both to complete this quest.",
  ],
  "quest.10DC489C1ACFF826.title": "Liquid Assets",
  "quest.10DC489C1ACFF826.quest_subtitle": "Experience, now in liquid form. Fill a bucket with XP Juice.",
  "quest.10DC489C1ACFF826.quest_desc": [
    "Stored experience is a fluid: &eXP Juice&r.",
    "",
    "Empty a full Syringe into a &eTank&r (right-click the Tank, or use its transfer slot), then scoop the XP Juice out with a bucket. An Absorption Hopper can collect XP from a farm for you.",
  ],
  "quest.5074A1D1D4B99B96.title": "Send in the Clones",
  "quest.5074A1D1D4B99B96.quest_subtitle": "Collect a mob's DNA and bring it back with the Clone-O-Matic.",
  "quest.5074A1D1D4B99B96.quest_desc": [
    "Use a &eDNA Collector&r on a mob to get a &eDNA Sample&r.",
    "",
    "Put the sample in a &eClone-O-Matic&r and it will start making copies of that mob. You need to be within 16 blocks when the first one appears.",
  ],
  "quest.1E056AE1C1969AF1.title": "Heads Will Roll",
  "quest.1E056AE1C1969AF1.quest_subtitle": "Fit a Mob Harvester with a Beheading Upgrade and take a trophy.",
  "quest.1E056AE1C1969AF1.quest_desc": [
    "Put a &eBeheading Upgrade&r in a Mob Harvester. Each upgrade gives a 10% chance for a mob to drop its head.",
    "",
    "Almost every mob has a head, not just the vanilla ones. Be within 16 blocks when one drops.",
  ],
  "quest.1AE082A987E981CF.title": "Head of the Class",
  "quest.1AE082A987E981CF.quest_subtitle": "Collect 25 different mob heads. Your walls have never looked so judgmental.",
  "quest.1AE082A987E981CF.quest_desc": [
    "Collect &e25 different mob heads&r. Vanilla heads count; player heads don't.",
    "",
    "They only have to pass through your inventory once, so feel free to put them on display as you go.",
  ],
  "quest.3F6935A10C0D7088.title": "Ba-Dum Tss",
  "quest.3F6935A10C0D7088.quest_subtitle": "Press a Rimshot Button. Thank you, we'll be here all week.",
  "quest.3F6935A10C0D7088.quest_desc": [
    "Craft and press a &eRimshot Button&r.",
    "",
    "There's also a Red Alert Button, a Dramatic Button and a Wilhelm Button, for every occasion.",
  ],
  "quest.14E28112AF5A5080.title": "Hat Trick",
  "quest.14E28112AF5A5080.quest_subtitle": "Amaze a villager by pulling a rabbit out of a Magic Hat.",
  "quest.14E28112AF5A5080.quest_desc": [
    "Right-click a rabbit with a &eMagic Hat&r to catch it.",
    "",
    "Then find a villager and right-click to release the rabbit within &e3 blocks&r of it. Ta-da!",
  ],
  "quest.1FFFBEB8312AF1AC.title": "It's the Thought That Counts",
  "quest.1FFFBEB8312AF1AC.quest_subtitle": "Wrap a block in a Present. Bonus points if it's a chest full of dirt.",
  "quest.1FFFBEB8312AF1AC.quest_desc": [
    "Use a &ePresent&r on almost any block to wrap it up, contents and all.",
    "",
    "Whoever unwraps it (sneak + right-click with an empty hand) gets the block back exactly as it was.",
  ],
  "quest.3973C58EFD097C00.title": "S'more, Please",
  "quest.3973C58EFD097C00.quest_subtitle": "Toast a marshmallow, assemble, and enjoy a S'more.",
  "quest.3973C58EFD097C00.quest_desc": [
    "Toast a &eMarshmallow&r, then sandwich it with a &eChocolate Bar&r between two &eGraham Crackers&r.",
    "",
    "Eat the result. Look for them in Picnic Baskets and village chests too.",
  ],
  "quest.1CDE9657427F42AF.title": "Royal Flush",
  "quest.1CDE9657427F42AF.quest_subtitle": "Flush a diamond down a Toilet. It's not like you needed it.",
  "quest.1CDE9657427F42AF.quest_desc": [
    "A &eToilet&r destroys anything piped into it.",
    "",
    "Send a &bdiamond&r (or a whole diamond block) in with a hopper while you're within 16 blocks, and wave goodbye.",
  ],
}
